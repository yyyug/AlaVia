# Environment Variables - Copy to .dev.vars for local development

# === REQUIRED ===

# Google Maps API Key - enables Street View, Geocoding, and Places APIs
# Get from: https://console.cloud.google.com/
# Required APIs: Maps SDK, Street View Static API, Map Tiles API, Places API, Geocoding API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google Gemini API Key - enables AI image descriptions
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# === OPTIONAL ===

# Google Vision API Key - Legacy, kept for backward compatibility
# Currently using Gemini 3 Flash Lite instead of Vision
GOOGLE_VISION_API_KEY=your_google_vision_key_here

# Allowed email addresses for production access (comma-separated)
# Example: "user1@example.com,user2@example.com"
# Leave empty to allow all authenticated users
# Local development (127.0.0.1, localhost) bypasses this check
ALLOWED_ACCESS_EMAILS=

# === CLOUDFLARE CONFIGURATION ===
# These are configured in wrangler.toml but can be overridden here

# D1 Database ID
ALAVIA_DB_ID=

# R2 Bucket Name (default: alavia-cache)
CACHE_BUCKET_NAME=alavia-cache

# === DEVELOPMENT ===

# API base URL for prefetch scripts
# Default: http://127.0.0.1:8787 (local dev server)
ALAVIA_BASE_URL=http://127.0.0.1:8787

# === NOTES ===

# .dev.vars is loaded automatically by Wrangler for local development
# .dev.vars is NOT committed to version control (add to .gitignore)
#
# For production deployment:
# 1. Use Cloudflare Workers Secrets instead: wrangler secret put <NAME>
# 2. Configure environment variables in wrangler.toml [env.production.vars]
# 3. Set secrets in Cloudflare dashboard or via wrangler secret put
#
# Example production setup:
#   wrangler secret put GOOGLE_MAPS_API_KEY --env production
#   wrangler secret put GEMINI_API_KEY --env production
